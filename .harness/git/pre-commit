#!/usr/bin/env bash
# Verifies the deterministic rules from the harness instruction block before
# allowing a commit. Installed via core.hooksPath=.harness/git.
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
harness_dir="$repo_root/.harness"

if command -v python3 >/dev/null 2>&1; then
  python3 "$harness_dir/git/verify_rules.py"
else
  echo "pre-commit: python3 not found, skipping harness rule verification" >&2
fi

common_dir="$(git rev-parse --git-common-dir)"
local_hook="$common_dir/hooks/pre-commit"
if [ -x "$local_hook" ]; then
  exec "$local_hook" "$@"
fi
