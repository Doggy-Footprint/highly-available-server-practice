{
  "hooks": [
    {
      "event": "SessionEnd",
      "command": "python3 \"{root}/.harness/bin/spec_lifecycle.py\" session"
    },
    {
      "event": "SessionStart",
      "matcher": "clear",
      "targets": ["codex"],
      "_note": "/clear in codex trigger this",
      "command": "python3 \"{root}/.harness/bin/spec_lifecycle.py\" session"
    },
    {
      "event": "SessionStart",
      "command": "python3 \"{root}/.harness/hooks/session_lock.py\""
    },
    {
      "event": "SessionEnd",
      "command": "python3 \"{root}/.harness/hooks/session_lock.py\""
    },
    {
      "event": "SubagentStart",
      "command": "python3 \"{root}/.harness/hooks/spec_gate.py\""
    },
    {
      "event": "SubagentStop",
      "command": "python3 \"{root}/.harness/hooks/spec_gate.py\""
    },
    {
      "event": "PreToolUse",
      "matcher": "Bash",
      "command": "python3 \"{root}/.harness/hooks/spec_gate.py\""
    },
    {
      "event": "PostToolUse",
      "matcher": "Bash|Write|Edit",
      "targets": ["claude"],
      "command": "python3 \"{root}/.harness/hooks/telemetry_hook.py\""
    },
    {
      "event": "PostToolUse",
      "matcher": "Bash|apply_patch",
      "targets": ["codex"],
      "command": "python3 \"{root}/.harness/hooks/telemetry_hook.py\""
    },
    {
      "event": "PostToolUseFailure",
      "matcher": "Bash",
      "targets": ["claude"],
      "command": "python3 \"{root}/.harness/hooks/telemetry_hook.py\""
    }
  ]
}
