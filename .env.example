# compose 가 기본값을 넣어주므로 로컬 개발(컨테이너 밖에서 앱을 직접 실행)할 때만 필요하다.
#
# 호스트에서 접근할 때의 포트는 컨테이너 안과 다르다:
#   PostgreSQL  localhost:15432  (5432 는 네이티브 PG 와 겹칠 수 있어 피했다 — compose.yaml 참고)
#   Redis       localhost:6379
#   app         localhost:8000   (N=1) / localhost:8080 (N=3, nginx)
#   mockpg      localhost:8100

# DATABASE_URL=postgresql+asyncpg://flashmart:flashmart@localhost:15432/flashmart
# REDIS_URL=redis://localhost:6379/0
# MOCKPG_URL=http://localhost:8100
# LOG_LEVEL=info
# DB_ECHO=false

# 실험별 장애 주입 — compose 가 읽는다 (deploy/compose.yaml 의 mockpg).
#   P1-06 (동기 결제 호출이 이벤트 루프를 막는가)
# MOCKPG_LATENCY_MS=800
#   P2-07 (재시도 폭풍)
# MOCKPG_FAIL_RATE=0.5
