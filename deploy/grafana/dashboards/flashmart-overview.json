{
  "uid": "flashmart-overview",
  "title": "FlashMart — Overview",
  "tags": ["flashmart"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "handler",
        "label": "handler",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(http_requests_total, handler)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "App — 표준 지표 (§8)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false
    },
    {
      "type": "timeseries",
      "title": "TPS (전체 / handler별)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "fillOpacity": 10 } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_requests_total[1m]))",
          "legendFormat": "total"
        },
        {
          "refId": "B",
          "expr": "sum by (handler) (rate(http_requests_total{handler=~\"$handler\"}[1m]))",
          "legendFormat": "{{handler}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Latency p50 / p95 / p99 (전체)",
      "description": "Phase 1 관문: p95 < 300ms. 임계선이 그려져 있다.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "fillOpacity": 0 },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.3 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(http_request_duration_seconds_bucket[1m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket[1m])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_request_duration_seconds_bucket[1m])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Error rate (5xx 비율)",
      "description": "Phase 1 관문: err < 1%. Phase 2 kill 중: err < 0.5%.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 9 },
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "min": 0, "custom": { "fillOpacity": 10 } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_requests_total{status=~\"5..\"}[1m])) / clamp_min(sum(rate(http_requests_total[1m])), 0.001)",
          "legendFormat": "5xx"
        },
        {
          "refId": "B",
          "expr": "sum(rate(http_requests_total{status=~\"4..\"}[1m])) / clamp_min(sum(rate(http_requests_total[1m])), 0.001)",
          "legendFormat": "4xx"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "p95 by handler",
      "description": "P1-06 / P1-10 확인용: 주문·로그인 부하가 무관한 GET 까지 밀어올리는지 여기서 본다.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 9 },
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "fillOpacity": 0 } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, handler) (rate(http_request_duration_seconds_bucket{handler=~\"$handler\"}[1m])))",
          "legendFormat": "{{handler}}"
        }
      ]
    },
    {
      "type": "row",
      "title": "PostgreSQL",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 17 },
      "collapsed": false
    },
    {
      "type": "timeseries",
      "title": "Active connections",
      "description": "§11: 총 커넥션 = 인스턴스 x 워커 x (pool_size + max_overflow). max_connections 기본 100. P1-12(세션 누수)는 여기가 서서히 우상향한다.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 18 },
      "fieldConfig": {
        "defaults": { "unit": "short", "min": 0, "custom": { "fillOpacity": 10 } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "pg_stat_database_numbackends{datname=\"flashmart\"}",
          "legendFormat": "backends"
        },
        {
          "refId": "B",
          "expr": "pg_settings_max_connections",
          "legendFormat": "max_connections"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Locks (mode별)",
      "description": "P2-01/02(핫 로우 직렬화), P2-03(deadlock) 관찰 지점.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 18 },
      "fieldConfig": {
        "defaults": { "unit": "short", "min": 0, "custom": { "fillOpacity": 10 } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (mode) (pg_locks_count{datname=\"flashmart\"})",
          "legendFormat": "{{mode}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Commit / Rollback, Deadlocks",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 18 },
      "fieldConfig": {
        "defaults": { "unit": "ops", "min": 0, "custom": { "fillOpacity": 0 } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(pg_stat_database_xact_commit{datname=\"flashmart\"}[1m])",
          "legendFormat": "commit/s"
        },
        {
          "refId": "B",
          "expr": "rate(pg_stat_database_xact_rollback{datname=\"flashmart\"}[1m])",
          "legendFormat": "rollback/s"
        },
        {
          "refId": "C",
          "expr": "rate(pg_stat_database_deadlocks{datname=\"flashmart\"}[1m])",
          "legendFormat": "deadlocks/s"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Tuples: returned vs fetched",
      "description": "seq scan 지표. returned 가 fetched 보다 압도적으로 크면 인덱스 없이 훑고 있다는 뜻 (P1-03).",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 26 },
      "fieldConfig": {
        "defaults": { "unit": "ops", "min": 0, "custom": { "fillOpacity": 0 } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(pg_stat_database_tup_returned{datname=\"flashmart\"}[1m])",
          "legendFormat": "returned/s (스캔한 행)"
        },
        {
          "refId": "B",
          "expr": "rate(pg_stat_database_tup_fetched{datname=\"flashmart\"}[1m])",
          "legendFormat": "fetched/s (실제 쓴 행)"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Cache hit ratio",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 26 },
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "min": 0, "max": 1, "custom": { "fillOpacity": 10 } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(pg_stat_database_blks_hit{datname=\"flashmart\"}[1m]) / clamp_min(rate(pg_stat_database_blks_hit{datname=\"flashmart\"}[1m]) + rate(pg_stat_database_blks_read{datname=\"flashmart\"}[1m]), 0.001)",
          "legendFormat": "shared_buffers hit"
        }
      ]
    },
    {
      "type": "row",
      "title": "Redis",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 34 },
      "collapsed": false
    },
    {
      "type": "timeseries",
      "title": "Ops/s, Connected clients",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 35 },
      "fieldConfig": {
        "defaults": { "unit": "short", "min": 0, "custom": { "fillOpacity": 0 } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(redis_commands_processed_total[1m])",
          "legendFormat": "commands/s"
        },
        {
          "refId": "B",
          "expr": "redis_connected_clients",
          "legendFormat": "clients"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Memory / maxmemory",
      "description": "§13: maxmemory=460mb (mem_limit 512m 의 90%), allkeys-lru. 여기가 maxmemory 에 닿으면 eviction 이지 OOM 이 아니다 — P2-13 과 구분할 것.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 35 },
      "fieldConfig": {
        "defaults": { "unit": "bytes", "min": 0, "custom": { "fillOpacity": 10 } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "redis_memory_used_bytes",
          "legendFormat": "used"
        },
        {
          "refId": "B",
          "expr": "redis_memory_max_bytes",
          "legendFormat": "maxmemory"
        },
        {
          "refId": "C",
          "expr": "rate(redis_evicted_keys_total[1m])",
          "legendFormat": "evicted/s"
        }
      ]
    }
  ]
}
